# Copy to .env and fill in. .env is gitignored: never commit real keys.
# An IBM Cloud key found in a public repo is deactivated and the hackathon account suspended.

# GitHub token (optional). Raises the API rate limit from 60 to 5000 requests/hour
# for fetching PR and issue text. A fine-grained token with public read-only access is enough.
GITHUB_TOKEN=

# Target repository to mine (defaults shown).
DEJABUG_REPO_SLUG=IBM/sarama
DEJABUG_REPO_DIR=workspace/sarama
DEJABUG_PORT=4317

# Brief generation provider: "watsonx" (batch, cheap) or "bob" (Bob Shell headless, spends Bobcoins).
LLM_PROVIDER=watsonx

# watsonx.ai (IBM Cloud hackathon account). Use an IBM Granite instruct model.
# Never use: llama-3-405b-instruct, mistral-medium-2505, mistral-small-3-1-24b-instruct-2503.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=

# Cost cap per `bob run` call when LLM_PROVIDER=bob.
BOB_MAX_COST=1

# Per-test timeout in seconds. A test still running at this point counts as a hang (a reproduced deadlock).
DEJABUG_TEST_TIMEOUT_SEC=45
