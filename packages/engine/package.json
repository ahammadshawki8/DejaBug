{
  "name": "@dejabug/engine",
  "version": "0.1.0",
  "description": "DejaBug engine: mines, certifies, and briefs real bug fixes into training cases.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dejabug": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/cli.ts serve",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dejabug": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
