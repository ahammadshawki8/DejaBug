{
  "name": "@dejabug/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:showcase": "tsc -p tsconfig.json --noEmit && vite build --mode showcase --outDir dist-showcase && node -e \"require('fs').copyFileSync('dist-showcase/index.html','dist-showcase/404.html')\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "diff2html": "^3.4.56",
    "framer-motion": "^13.4.4",
    "pixelarticons": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
